---
import Base from "../layouts/Base.astro";
---

<Base title="Not found" description="This page doesn't exist.">
  <section class="pt-6">
    <p class="text-sm font-semibold text-muted tabular-nums">404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight">This page doesn't exist.</h1>
    <p class="mt-3 text-muted">
      It may have moved in the v2 rebuild. The old site is still at
      <a href="https://v1.jianlee.me" target="_blank" rel="noopener" class="text-accent underline">v1.jianlee.me</a>.
    </p>
    <a href="/" class="mt-6 inline-block text-accent hover:underline">← Back home</a>
  </section>
</Base>
