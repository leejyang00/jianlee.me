---
import { getEntry } from "astro:content";
import Icon from "../../components/Icon.astro";
import Base from "../../layouts/Base.astro";

const entry = await getEntry("resume", "main");
if (!entry) throw new Error("src/content/resume.json is missing");
const resume = entry.data;
---

<Base title="Resume" description={`${resume.headline}, ${resume.location}.`}>
  <header class="pt-6 pb-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold tracking-tight">Resume</h1>
        <p class="mt-1 text-muted">{resume.headline} · {resume.location}</p>
      </div>
      <a
        href={resume.pdfUrl}
        class="inline-flex items-center gap-2 rounded-lg bg-fg px-3.5 py-2 text-sm font-medium text-bg hover:opacity-90"
      >
        <Icon name="download" class="size-4" /> Download PDF
      </a>
    </div>
    <p class="mt-6 leading-relaxed">{resume.profile}</p>
  </header>

  <section class="pb-10" aria-labelledby="experience">
    <h2 id="experience" class="mb-4 text-sm font-semibold tracking-wide text-muted uppercase">Experience</h2>
    <ol class="space-y-8">
      {
        resume.experience.map((job) => (
          <li>
            <div class="flex flex-wrap items-baseline justify-between gap-x-4">
              <h3 class="font-semibold">{job.role}</h3>
              <span class="text-sm text-muted tabular-nums">{job.period}</span>
            </div>
            <p class="text-sm text-muted">
              {job.company} · {job.location}
            </p>
            {job.blurb && <p class="mt-2 text-sm italic text-muted">{job.blurb}</p>}
            {job.bullets.length > 0 && (
              <ul class="mt-3 list-disc space-y-1.5 pl-5 text-[0.95rem] leading-relaxed marker:text-muted">
                {job.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  <section class="pb-10" aria-labelledby="projects">
    <h2 id="projects" class="mb-4 text-sm font-semibold tracking-wide text-muted uppercase">Projects</h2>
    <ul class="space-y-6">
      {
        resume.projects.map((project) => (
          <li>
            <h3 class="font-semibold">{project.title}</h3>
            <p class="text-sm text-muted">{project.org}</p>
            <ul class="mt-2 list-disc space-y-1.5 pl-5 text-[0.95rem] leading-relaxed marker:text-muted">
              {project.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
            {project.stack && <p class="mt-2 text-sm text-muted">Stack: {project.stack}</p>}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="pb-10" aria-labelledby="skills">
    <h2 id="skills" class="mb-4 text-sm font-semibold tracking-wide text-muted uppercase">Skills</h2>
    <dl class="space-y-3">
      {
        resume.skills.map((group) => (
          <div class="sm:grid sm:grid-cols-[10rem_1fr] sm:gap-4">
            <dt class="font-medium">{group.category}</dt>
            <dd class="text-muted">{group.items.join(", ")}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="pb-10" aria-labelledby="certifications">
    <h2 id="certifications" class="mb-4 text-sm font-semibold tracking-wide text-muted uppercase">Certifications</h2>
    <ul class="space-y-2">
      {
        resume.certifications.map((cert) => (
          <li class="flex flex-wrap justify-between gap-x-4">
            <span>{cert.name}</span>
            <span class="text-sm text-muted">{cert.date}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="pb-10" aria-labelledby="education">
    <h2 id="education" class="mb-4 text-sm font-semibold tracking-wide text-muted uppercase">Education</h2>
    {
      resume.education.map((school) => (
        <div class="mb-6 last:mb-0">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold">{school.school}</h3>
            <span class="text-sm text-muted tabular-nums">{school.period}</span>
          </div>
          <p class="text-sm text-muted">
            {school.degree} · {school.location}
          </p>
          {school.bullets.length > 0 && (
            <ul class="mt-3 list-disc space-y-1.5 pl-5 text-[0.95rem] leading-relaxed marker:text-muted">
              {school.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          )}
        </div>
      ))
    }
  </section>

  <section aria-labelledby="interests">
    <h2 id="interests" class="mb-4 text-sm font-semibold tracking-wide text-muted uppercase">Interests</h2>
    <ul class="list-disc space-y-1.5 pl-5 text-[0.95rem] leading-relaxed marker:text-muted">
      {resume.interests.map((interest) => <li>{interest}</li>)}
    </ul>
  </section>
</Base>
