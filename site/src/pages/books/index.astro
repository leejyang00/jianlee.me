---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const books = await getCollection("books");

// Year headings come from the data, newest first.
const byYear = Map.groupBy(books, (book) => book.data.read_year);
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<Base title="Books" description="Books I've read, grouped by the year I read them.">
  <header class="pt-6 pb-10">
    <h1 class="text-3xl font-bold tracking-tight">Books</h1>
    <div class="mt-3 space-y-3 leading-relaxed text-muted">
      <p>
        Books that have shaped how I think, grouped by the year I read them. The topics I keep coming back to are
        philosophy, business and entrepreneurship, tech and AI, leadership, and biographies.
      </p>
      <p>Each cover links to the book on Amazon.</p>
    </div>
  </header>

  {
    years.map((year) => (
      <section class="pb-10" aria-labelledby={`year-${year}`}>
        <h2 id={`year-${year}`} class="mb-4 flex items-baseline gap-3 text-xl font-semibold">
          {year}
          <span class="text-sm font-normal text-muted">{byYear.get(year)!.length} books</span>
        </h2>
        <ul class="grid grid-cols-3 gap-x-4 gap-y-6 sm:grid-cols-4">
          {byYear.get(year)!.map(({ data: book }) => (
            <li>
              <a href={book.affiliate_link} rel="sponsored noopener" class="group block">
                <img
                  src={book.thumbnail}
                  alt=""
                  width="128"
                  height="192"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[2/3] w-full rounded-md bg-surface object-cover shadow-sm ring-1 ring-border transition-transform group-hover:-translate-y-0.5"
                />
                <p class="mt-2 line-clamp-2 text-sm leading-snug font-medium group-hover:text-accent">{book.title}</p>
                <p class="mt-0.5 line-clamp-1 text-xs text-muted">{book.authors.join(", ")}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
