---
import Icon from "./Icon.astro";
---

<button
  type="button"
  data-theme-toggle
  class="ml-1 grid size-8 place-items-center rounded-md text-muted hover:text-fg"
  aria-label="Toggle dark mode"
>
  <Icon name="moon" class="size-4 dark:hidden" />
  <Icon name="sun" class="hidden size-4 dark:block" />
</button>

<script>
  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    try {
      localStorage.setItem("theme", dark ? "dark" : "light");
    } catch {
      // Private mode or blocked storage: the toggle still works for this page view.
    }
  });
</script>
