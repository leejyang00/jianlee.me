---
import { render, type CollectionEntry } from "astro:content";
import { formatDate } from "../lib/content";

interface Props {
  entry: CollectionEntry<"now">;
  /** Compact mode (home page): title and date only, linking to the entry on /now. */
  compact?: boolean;
}

const { entry, compact = false } = Astro.props;
const { title, date, product, links } = entry.data;
const { Content } = await render(entry);
---

{
  compact ? (
    <li>
      <a href={`/now/#${entry.id}`} class="group flex items-baseline justify-between gap-4 py-2">
        <span class="group-hover:text-accent">{title}</span>
        <time datetime={date.toISOString()} class="shrink-0 text-sm text-muted tabular-nums">
          {formatDate(date)}
        </time>
      </a>
    </li>
  ) : (
    <article id={entry.id} class="scroll-mt-6 border-b border-border py-8 first:pt-0 last:border-0">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
        <time datetime={date.toISOString()} class="tabular-nums">
          {formatDate(date)}
        </time>
        {product && <span class="rounded-full bg-accent-soft/12 px-2 py-0.5 text-xs font-medium text-accent">{product}</span>}
      </div>
      <h2 class="mt-1.5 text-lg font-semibold">
        <a href={`#${entry.id}`} class="hover:text-accent">
          {title}
        </a>
      </h2>
      <div class="prose mt-3">
        <Content />
      </div>
      {links && links.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm">
          {links.map((link) => (
            <li>
              <a href={link.url} class="text-accent hover:underline" rel="noopener">
                {link.label} ↗
              </a>
            </li>
          ))}
        </ul>
      )}
    </article>
  )
}
